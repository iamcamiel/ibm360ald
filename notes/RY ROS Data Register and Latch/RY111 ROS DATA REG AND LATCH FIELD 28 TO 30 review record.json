      {
        "location": "Lower connector first line",
        "evidence": "RY111/lower connector table enlarged.png; RY111/left upper full.png",
        "observation": "The lower table prints FF071AA4; the left margin prints EF071AA4. Both distinct source forms are retained."
      },
      {
        "location": "Lower connector 02E family",
        "evidence": "RY111/lower connector table enlarged.png; RY111/lower table E4L three lines.png",
        "observation": "The row97 and row99 connector-table lines print 02E-F4L7D04 and 02E-F4L7D05. The row101 line instead prints 02E-E4L7D06. These distinct native letters are retained; A1 and the two neighboring table lines do not replace the scan print."
      },
      {
        "location": "A1 native census",
        "evidence": "RY111 full-bank source strips; RY111 gate pin montages",
        "observation": "45 native gate boxes are present and all match A1 card portions. A1 lists 47 portions; 3311B1 and 3311B3 have no native RY111 gate boxes. Duplicate printed DF identifiers at 2M and 3M refer to distinct 3596A4 and 3596A5 portions."
      },
      {
        "location": "2H/AS and 5E/BH physical join",
        "evidence": "RY111/2H box and output.png; RY111/BH branch calibrated full.png; RY111/BH AS AM calibrated right.png",
        "observation": "5E D04 branches down c159 to row46, east to c199, then north through a plain row45 crossing to the printed c199,row44 diamond. 2H D09 rises to the row44 DR081 continuation and meets that diamond. The two gate outputs are physically joined on the native page despite distinct BH and DR081 printed continuations; both physical pins are preserved as co-drivers."
      },
      {
        "location": "Top clock and row19 register conductor",
        "evidence": "RY111/c113 clock-to-AR full native.png; RY111/c113 full clock stem native.png; RY111/CK feedback calibrated left.png",
        "observation": "The top -CLOCK P1 conductor branches at c113,row1, reaches 4A 2D09 near row7, and separately reaches 6B 2D09 from c159. It does not descend to the row19 AR register rail. The row19 diamond belongs to the distinct c114 feedback conductor."
      },
      {
        "location": "Native row21 open conductor",
        "evidence": "RY111/row21 apparent gap exact.png; RY111/row21 feedback full-width native.png; RY111/right interior row21 gap context.png; RY111/row49 interior gap context.png; RY111/row77 interior gap context.png",
        "observation": "A one-cell blank gap is printed between the left c115/4B D02 feedback segment ending about c176 and the right 7B/CK D02 segment beginning about c178. Rows49 and77 are continuous by comparison. The row21 segments are left separate; CK is an external continuation only."
      },
      {
        "location": "4H/BL RY011 return",
        "evidence": "RY111/BL output calibrated route.png; RY111/BL output right calibrated route.png; RY111/BL far right calibrated route.png; RY111/BL right return exact.png",
        "observation": "4H D07 runs east along row54 to c159, rises to row48, runs east to c201, and rises on a regularly dashed native vertical through row42. The row42 RY011 legend is connected. Ordinary spaces between printed dash strokes are not an open conductor."
      },
      {
        "location": "Native joins and crossings",
        "evidence": "RY111/diamond atlas 0.png through diamond atlas 3.png; RY111/crossing atlas 0.png through crossing atlas 6.png",
        "observation": "The 41 declared hollow diamonds and 80 declared plain crossings were compared individually with native enlarged TIFF crops. Adjacent rails stay separate at every plain intersection; no extra hollow source diamond was found in the full-page and source-only candidate pass."
      }
