    "review_notes": [
      {
        "location": "2N source/A1 discrepancy",
        "evidence": "Native lower bank-2 crop reads U03AR 0498C1 E-B3D2 2N-BC. KU371 A1 page listing has no 0498C1 portion."
      },
      {
        "location": "A1-only 02E-B3 K4 and J5",
        "evidence": "KU371 A1 lists 0410H1 and 0410J1 at K4, and 3351B1 and 3351G1 at J5. A complete original-resolution sweep of all seven block columns from rank A through N, including off-grid spaces and lower bank strips, shows no printed bodies with those four identifiers. They are kept as A1-only listing discrepancies; no source block or pin is invented."
      },
      {
        "location": "5D.B03 and +SYNC LATCH",
        "evidence": "Native tall vertical from 4K.D10 has an output diamond at rank K, then runs up to 5D.B03 and branches with a separate diamond onto the +SYNC LATCH right rail. It plain-crosses the 4D.D05/5D.B05 line."
      },
      {
        "location": "1K.D04 and 3M.B10 return",
        "evidence": "Native lower strip: 1K.D04 descends on x≈3068 to y≈5070; 3M.B10 descends from the separate right-hand y≈4962 rail. Both reach the -SYNC LATCH right continuation, whose x≈5250 diamond joins the 3K.B04 output return. The adjacent left-hand -MAINT MODE STOP CLOCK rail stops before the 3M branch."
      },
      {
        "location": "5K.B04 return",
        "evidence": "Native vertical x≈6362 runs from 5K.B04 down to 5M.D04, where the 2N.D06 return joins with a printed diamond; the adjacent 5K.D04 to 5M.D02 vertical at x≈6325 is separate."
      },
      {
        "location": "2N.B09 lower left fanout",
        "evidence": "Native lower-left strip has a diamond on +ROS TEST + FLT + DIAG FLT at x≈3885,y≈5125. Its vertical continues to 2N.B09, plain-crossing 2M.B05 and the +SCAN MODE branch into 2N.B08. The adjacent -CLOCK P0-1 rail is separate."
      },
      {
        "location": "+SORDS TGR to 4M.B13",
        "evidence": "Native raw y≈4800 +SORDS TGR rail ends at an x≈5467 diamond. Its vertical crosses the intervening horizontals without diamonds, then bends into 4M.B13. The adjacent 3K.B04 and -MACH RESET returns are separate."
      }
