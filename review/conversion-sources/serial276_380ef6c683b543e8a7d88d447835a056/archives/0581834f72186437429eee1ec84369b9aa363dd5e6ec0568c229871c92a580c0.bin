from pathlib import Path
import json,copy,hashlib

def load(data):
 def pairs(xs):
  d={}
  for k,v in xs:
   assert k not in d,('Duplicate JSON member',k);d[k]=v
  return d
 def bad(v):raise ValueError('Nonfinite JSON: '+v)
 return json.loads(data,object_pairs_hook=pairs,parse_constant=bad)
def checked(b):return load(B.checked(b))
def digest(d):return hashlib.sha256(json.dumps({k:v for k,v in d.items()if k!='review'},ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False).encode('utf8')).hexdigest()

def historical_issue_binding(b,plan,before):
 """A publication may replace the very V3 bytes named by a historical report."""
 data=B.raw(b['path'])
 if B.sha(data)==b['sha256']:return None
 else:
  replacements=[x for x in plan['writes']if x['purpose']in ['canonical_json','canonical_txt','external_review']and x['before']==b and x['target']==b['path']]
  assert len(replacements)==1,('Unexplained retained issue binding drift',b)
  relative=Path(b['path']).relative_to(B.R).as_posix()
  assert before[relative]==b['sha256']
  archives=[x for x in plan['writes']if x['purpose']=='archive'and x['before']is None and x['source']['sha256']==b['sha256']]
  assert archives,('Missing exact archived historical issue preimage',b)
  for x in archives:
   B.checked(x['source']);B.checked(dict(path=x['target'],sha256=b['sha256']))
  return dict(original_binding=b,exact_transaction_preimage_verified=True,archived_exact_bytes=[dict(path=x['target'],sha256=b['sha256'])for x in archives],live_path_is_authorized_successor=True)
