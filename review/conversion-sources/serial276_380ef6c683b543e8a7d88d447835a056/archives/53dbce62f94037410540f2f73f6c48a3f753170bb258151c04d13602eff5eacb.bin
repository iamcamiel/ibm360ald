class Rejected(RuntimeError): pass

def require(value, message):
    if not value: raise Rejected(message)
def sha(data): return hashlib.sha256(data).hexdigest()
def load(data):
    def pairs(items):
        result = {}
        for k,v in items:
            require(k not in result, 'duplicate JSON member: '+k); result[k]=v
        return result
    return json.loads(data, object_pairs_hook=pairs, parse_constant=lambda x: (_ for _ in ()).throw(Rejected('nonfinite JSON')))
def encoded(value): return (json.dumps(value,ensure_ascii=False,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8')
def absolute(value):
    p=Path(value)
    require(not str(p).startswith(chr(92)*2) and re.fullmatch(r'[A-Za-z]:',p.drive) is not None,'canonical drive path required')
    require(p.is_absolute() and '..' not in p.parts, 'absolute lexical path required')
    require(not any(':' in x or x.endswith((' ','.')) for x in p.parts[1:]), 'unsafe Windows path component')
    require(not any(re.fullmatch(r'(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\..*)?',x,re.I) for x in p.parts[1:]),'reserved DOS device path')
    return p

def guard(p, missing=False):
    p=absolute(str(p))
    for q in reversed((p,)+tuple(p.parents)):
        try: s=q.lstat()
        except FileNotFoundError:
            require(missing, 'missing path: '+str(q)); continue
        require(not stat.S_ISLNK(s.st_mode) and not (getattr(s,'st_file_attributes',0)&0x400), 'symlink/reparse forbidden: '+str(q))
        if q==p and not stat.S_ISDIR(s.st_mode):
            require(stat.S_ISREG(s.st_mode) and s.st_nlink==1, 'single-link regular file required: '+str(q))
    return p

def readpath(p):
    guard(p); return Path(p).read_bytes()
def checked(binding):
    data=readpath(absolute(binding['path']))
    require(sha(data)==binding['sha256'], 'stale binding: '+binding['path']); return data

def within(p,root):
    return p==root or p.is_relative_to(root)
def key(p): return os.path.normcase(str(p))
def digest(model):
    return sha(json.dumps({k:v for k,v in model.items() if k!='review'},ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False).encode('utf8'))
def maprepo(root):
    guard(root); result={}
    for parent,dirs,files in os.walk(root,followlinks=False):
        dirs[:]=sorted(d for d in dirs if d not in {'.git','.vs'})
        for d in dirs: guard(Path(parent)/d)
        for name in sorted(files):
            p=Path(parent)/name; result[p.relative_to(root).as_posix()]=sha(readpath(p))
    return result

def exclusive_new(path,data):
    guard(path,True)
    fd=os.open(str(path), os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    try:
        with os.fdopen(fd,'wb') as f: f.write(data); f.flush(); os.fsync(f.fileno())
    except BaseException: raise

def transition(path,before,after,temporary):
    """Atomic replacement under cooperative lease; no CAS claim against hostile rename.
    Exact temporary is Root-granted, absent, single-link and in the same directory.
    """
    guard(path,before is None); guard(temporary,True)
    require(not temporary.exists(),'temporary already exists')
    exclusive_new(temporary,after)
    try:
        require(readpath(temporary)==after,'temporary afterimage differs')
        if before is None:
            # Windows rename without replacement fails atomically if another file appears.
            require(os.name=='nt','Windows atomic no-replace rename required')
            os.rename(temporary,path)
        else:
            require(os.name=='nt','existing-target transition requires Windows')
            import msvcrt
            kernel=ctypes.WinDLL('kernel32',use_last_error=True)
            create=kernel.CreateFileW
            create.argtypes=[ctypes.c_wchar_p,ctypes.c_uint32,ctypes.c_uint32,ctypes.c_void_p,ctypes.c_uint32,ctypes.c_uint32,ctypes.c_void_p]
            create.restype=ctypes.c_void_p
            h=create(str(path),0x80000000,4,None,3,0x80|0x00200000,None)
            require(h not in (None,ctypes.c_void_p(-1).value),'exclusive preimage handle failed: '+str(path))
            fd=msvcrt.open_osfhandle(h,os.O_RDONLY|os.O_BINARY)
            with os.fdopen(fd,'rb') as f:
                st=os.fstat(f.fileno())
                require(stat.S_ISREG(st.st_mode) and st.st_nlink==1,'preimage handle not single regular')
                require(f.read()==before,'preimage changed: '+str(path))
                guard(path); guard(temporary)
                live=path.stat()
                require((live.st_dev,live.st_ino)==(st.st_dev,st.st_ino),'target renamed before replacement')
            # Windows denies replacement while this preimage handle remains open.
            # Close it, recheck bytes immediately, then atomically replace under publisher lease.
            require(readpath(path)==before,'preimage changed immediately before atomic replace')
            live=path.stat()
            require((live.st_dev,live.st_ino)==(st.st_dev,st.st_ino),'preimage identity changed before atomic replace')
            os.replace(temporary,path)
    finally:
        if temporary.exists():
            # A failed write can leave a partial owned temporary: only full own bytes may be removed.
            if readpath(temporary)==after: remove_own(temporary,after)

def remove_own(path,expected):
    # Keep exclusive Windows handle until delete disposition is set; no name-based unlink race.
    require(os.name=='nt','rollback deletion requires Windows exclusive handles')
    import msvcrt
    kernel=ctypes.WinDLL('kernel32',use_last_error=True)
    create=kernel.CreateFileW; create.argtypes=[ctypes.c_wchar_p,ctypes.c_uint32,ctypes.c_uint32,ctypes.c_void_p,ctypes.c_uint32,ctypes.c_uint32,ctypes.c_void_p]; create.restype=ctypes.c_void_p
    guard(path); h=create(str(path),0x80000000|0x00010000,0,None,3,0x80|0x00200000,None)
    require(h not in (None,ctypes.c_void_p(-1).value),'rollback exclusive open failed')
    fd=msvcrt.open_osfhandle(h,os.O_RDONLY|os.O_BINARY)
    with os.fdopen(fd,'rb') as f:
        require(os.fstat(f.fileno()).st_nlink==1 and f.read()==expected,'competing afterimage preserved')
        flag=ctypes.c_int(1)
        require(kernel.SetFileInformationByHandle(ctypes.c_void_p(h),4,ctypes.byref(flag),ctypes.sizeof(flag))!=0,'delete disposition failed')


def normalize_record(record):
    """No aliases inferred: all 12 manifest selection kinds use these frozen fields.
    Source has model,text and optional raw. Missing raw is absence, never native evidence.
    Complete record is retained verbatim as provenance, including all issue/hold history.
    """
    require(set(record['source']) in ({'model','text'},{'model','text','raw'}),'unsupported frozen source roles')
    selection=record['Root_source_selection']
    if set(selection)=={'path','sha256'}: binding=selection
    else:
        require(set(selection)=={'baseline','method'} and isinstance(selection['method'],str) and selection['method'].strip(),'unsupported frozen selection authority shape')
        binding=selection['baseline']; require(set(binding)=={'path','sha256'},'invalid baseline selection binding')
    return {'source':copy.deepcopy(record['source']),'canonical_preimage':copy.deepcopy(record['canonical_preimage']),'source_selection':copy.deepcopy(binding)}

def required_issue_reports(record):
    """Conservative exact report/hold references; opaque reports retained without invented PASS."""
    result=[]
    def visit(value,trail=()):
        if isinstance(value,dict):
            if set(value)=={'path','sha256'}:
                if any(any(word in k.lower() for word in ('report','hold','review')) for k in trail) and value not in result: result.append(copy.deepcopy(value))
            else:
                for k,v in value.items(): visit(v,trail+(k,))
        elif isinstance(value,list):
            for v in value: visit(v,trail)
    visit(record)
    return result

# Acyclic subject: helper is frozen first; Root qualifies final exact subject later.
EXPECTED_HELPER_SHA256 = '5538f120dd3d8ba0ace9c592c8b036747add7a30c1d63e946913518a2c020a51'


def load_source_amendment_helper():
    """Authenticate sibling source, compile that exact buffer, execute a fresh module.
    Uses inherited path checks; no stronger OS race/CAS guarantee is claimed.
    No helper import resolution, sys.modules reuse/insertion, or bytecode fallback.
    compiled_input_sha256 identifies source bytes, not a code-object serialization.
    """
    path=absolute(str(Path(__file__).parent/'source_amendment321.py'))
    source=readpath(path)
    measured=sha(source)
    require(measured==EXPECTED_HELPER_SHA256,'authenticated helper SHA256 mismatch')
    resolved=str(path.resolve(strict=True))
    module_name='_publisher321_authenticated_helper_'+EXPECTED_HELPER_SHA256
    code=compile(source,resolved,'exec',dont_inherit=True)
    helper=types.ModuleType(module_name)
    helper.__file__=resolved
    helper.__package__=''
    exec(code,helper.__dict__)
    require(callable(helper.admit) and helper.admit.__module__==module_name and helper.admit.__code__.co_filename==resolved,'authenticated helper callable identity mismatch')
    evidence={'module_name':module_name,'resolved_path':resolved,'expected_sha256':EXPECTED_HELPER_SHA256,'authenticated_sha256':measured,'compiled_input_sha256':sha(source),'code_filename':code.co_filename,'admit_module':helper.admit.__module__,'admit_code_filename':helper.admit.__code__.co_filename}
    return helper,evidence


