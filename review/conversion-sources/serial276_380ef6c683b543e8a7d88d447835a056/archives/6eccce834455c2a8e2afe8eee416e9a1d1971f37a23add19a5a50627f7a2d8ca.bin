def require(value,message):
    if not value: raise AssertionError(message)

def sha(data): return hashlib.sha256(data).hexdigest()
def encoded(value): return (json.dumps(value,ensure_ascii=False,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8')
def load(data):
    def pairs(items):
        result={}
        for key,value in items:
            require(key not in result,'duplicate JSON member'); result[key]=value
        return result
    def bad(value): raise ValueError('nonfinite JSON '+value)
    return json.loads(data.decode('utf-8',errors='strict') if isinstance(data,bytes) else data,object_pairs_hook=pairs,parse_constant=bad)

def required_issue_reports(record):
    result=[]
    def visit(value,trail=()):
        if isinstance(value,dict):
            if set(value)=={'path','sha256'}:
                if any(any(word in k.lower() for word in ('report','hold','review')) for k in trail) and value not in result: result.append(copy.deepcopy(value))
            else:
                for k,v in value.items(): visit(v,trail+(k,))
        elif isinstance(value,list):
            for v in value: visit(v,trail)
    visit(record); return result

def historical_bytes(binding,plan,before,root,raw):
    """Strict319: raw path guard errors propagate BEFORE considering hash drift."""
    data=raw(binding['path'])
    if sha(data)==binding['sha256']: return data
    replacements=[w for w in plan['writes'] if w['purpose'] in ('canonical_json','canonical_txt','external_review') and w['before']==binding and w['target']==binding['path']]
    require(len(replacements)==1,'unexplained historical binding drift')
    relative=Path(binding['path']).relative_to(root).as_posix()
    require(before[relative]==binding['sha256'],'historical beforemap mismatch')
    archives=[w for w in plan['writes'] if w['purpose']=='archive' and w['before'] is None and w['source']['sha256']==binding['sha256']]
    require(bool(archives),'missing exact archived historical preimage')
    for w in archives:
        require(sha(raw(w['source']['path']))==binding['sha256'],'archive source drift')
        archived=raw(w['target']); require(sha(archived)==binding['sha256'],'archive target drift')
    return archived

def select_branch(process,trusted_root_state,checked):
    """Unknown/321 identifiers cannot enter the old legacy-process fallback."""
    new=process.get('runner_sha256')==SUBJECT['guarded_publisher276.py'] or any(k in process for k in ('publisher_subject','launcher_sha256'))
    if not new:
        require(process.get('runner_sha256',OLD_RUNNER)==OLD_RUNNER,'unknown runner')
        require(process.get('Gate_sha256',OLD_GATE)==OLD_GATE,'unknown/mixed Gate')
        return None
    require('transaction_success' in process,'321 cannot use legacy success fallback')
    require(isinstance(trusted_root_state,dict),'missing external Root trust capability')
    require(set(trusted_root_state)=={'record_binding','record','receiver_manifest'},'invalid external Root trust capability')
    q=load(checked(trusted_root_state['record_binding']))
    require(q==trusted_root_state['record'],'Root qualification differs from trusted snapshot')
    require(q['format']=='PROPOSED-Root-external-receiver-qualification343-v1' and q['activated'] is True and q['local_only'] is False,'not activated external qualification')
    require(q['fresh_different_team_qualification'] is True and q['qualification_team']!=q['implementation_team'],'fresh different-team qualification absent')
    require(q['publisher_subject']==SUBJECT==process['publisher_subject'],'exact321C004 subject mismatch')
    require(q['receiver_manifest']==trusted_root_state['receiver_manifest'],'receiver proposal mismatch')
    checked(q['receiver_manifest'])
    require(q['publisher_manifest']==PUBLISHER_MANIFEST,'publisher manifest mismatch')
    checked(PUBLISHER_MANIFEST)
    require(q['contracts']==CONTRACTS,'matrix/policy/323/325/DATA322 mismatch')
    for b in CONTRACTS.values(): checked(b)
    for b in PUBLISHER_FILES: checked(b)
    for role in ('independent_CODE','independent_DATA'):
        evidence=load(checked(q[role]))
        require(evidence==q['qualified_evidence'][role],'qualification evidence differs from Root authenticated snapshot')
        require(evidence['subject']==SUBJECT and evidence['receiver_manifest']==q['receiver_manifest'] and evidence['local_only'] is False and evidence['qualified'] is True,'local-only or wrong-subject qualification evidence')
        require(evidence['team']!=q['implementation_team'],'same-team qualification')
    require(process['runner_sha256']==SUBJECT['guarded_publisher276.py'] and process['launcher_sha256']==SUBJECT['launch321.py'],'runner/launcher drift')
    require(process['interpreter']==q['interpreter']==INTERPRETER and process['interpreter_flags']==['-I','-S','-B'],'launcher runtime mismatch')
    checked(INTERPRETER)
    gate=load(checked(q['Gate']))
    require(process['Gate_sha256']==q['Gate']['sha256'] and gate['subject']==SUBJECT,'Gate mismatch')
    for role,key in (('matrix','matrix'),('policy','original_policy')): require(gate[role]==CONTRACTS[key],'Gate contract mismatch')
    return q

class Evidence:
    """Read-only adapter. raw and guard MUST be strict original Root guards in integration.
    DATA may inject private fixture readers explicitly; no production test override exists.
    """
    require=staticmethod(require); sha=staticmethod(sha); load=staticmethod(load); encoded=staticmethod(encoded)
    required_issue_reports=staticmethod(required_issue_reports)
    def __init__(self,plan,before,root,raw,guard):
        self.plan=plan; self.before=before; self.root=Path(root); self.raw=raw; self.guard=guard
        self.PRODUCTION_BINDINGS={'matrix':CONTRACTS['matrix']}
    def checked(self,b): return historical_bytes(b,self.plan,self.before,self.root,self.raw)
    def absolute(self,p):
        p=Path(p); require(p.is_absolute(),'absolute path required'); return p
    def within(self,p,root): return p.is_relative_to(root)
    def candidate_subject(self): return dict(SUBJECT)

def verify_page_evidence(p,page,entry):
    """Check exact actual saved process once, emitted DATA/TXT, original/current preimages."""
    q=page['qualification']; proc=p.load(p.checked(q['process']))
    require(type(proc.get('exit_code')) is int and proc['exit_code']==0 and proc['execution_count']==1 and proc['retried'] is False,'actual saved process failed/retried')
    current=p.load(p.checked(entry['current_keys']))
    for role in ('model','text'):
        require(proc['source'][role]['sha256']==page['source'][role]['sha256'],'actual process source drift')
    if 'raw' in page['source']: require(proc['source'].get('raw',proc['source'].get('restored_raw',{})).get('sha256')==page['source']['raw']['sha256'],'actual process raw drift')
    archives=[w for w in p.plan['writes'] if w['purpose']=='archive' and w['before'] is None]
    for b in proc['source'].values():
        p.checked(b); require(any(w['source']['sha256']==b['sha256'] for w in archives),'process source archive absent')
    for role in ('converter','renderer','schema'):
        require(proc['tools'][role]==current['tools'][role] and proc['tools'][role]['sha256']==q['tools'][role]['sha256'],'actual process tool literal drift')
        p.checked(q['tools'][role])
    validate_saved_argv(p,proc,q,page['page'],entry['source_review'])
    exact={'format':'successful-conversion276-v1','page':page['page'],'exit_code':0,'emitted':True,'source':page['source'],'data':q['emitted_data'],'txt':page['txt'],'original_review':page['original_review'],'tools':q['tools'],'format_decisions':q['format_decisions'],'process':q['process'],'conversion_report':q['conversion_report']}
    require(p.load(p.checked(q['execution']))==exact,'normalized execution mismatch')
    require({k:v for k,v in p.load(p.checked(page['data'])).items() if k!='review'}=={k:v for k,v in p.load(p.checked(q['emitted_data'])).items() if k!='review'},'saved emitted functional DATA changed')
    for role in ('stdout','stderr'):
        if role in proc and isinstance(proc[role],dict):
            p.checked(proc[role]); require(any(w['source']==proc[role] for w in archives),'process capture archive absent')
    subject={k:page[k] for k in ('source','data','txt','original_review','final_review','schema')}
    subject.update({k:q[k] for k in ('source_key','source_selection','tools','format_decisions','dual_consumers')})
    require(q['subject']==subject and q['dual_consumers']==p.plan['dual_consumers'],'qualification exact subject/consumers mismatch')
    report=p.load(p.checked(q['conversion_report']))
    require(report.get('dry run') is False and report.get('source writes')==0 and report.get('counts',{}).get('blocked')==0,'dry/nonemitting conversion report')
    rows=report.get('pages',[])
    require(len(rows)==1 and rows[0].get('page')==page['page'] and rows[0].get('status') in ('converted','converted with findings'),'successful report page/status missing')
    require(rows[0].get('source')==proc['source']['model']['path'] and rows[0].get('output')==q['emitted_data']['path'],'report source/output mismatch')
    for b in (q['process'],q['conversion_report'],q['emitted_data']): require(any(w['source']['sha256']==b['sha256'] for w in archives),'actual process/report/DATA archive missing')
    original=entry['original_record']
    for target,purpose,binding in ((page['canonical_json'],'canonical_json',original['canonical_preimage']['json']),(page['canonical_txt'],'canonical_txt',original['canonical_preimage']['text'])):
        writes=[w for w in p.plan['writes'] if w['target']==target and w['purpose']==purpose]
        require(len(writes)==1 and writes[0]['before']==binding,'original canonical V3 preimage drift')
        p.checked(binding)
    for b in [*original['source'].values(),*page['source'].values(),page['original_review'],*required_issue_reports(original)]:
        p.checked(b); require(any(w['source']['sha256']==b['sha256'] for w in archives),'original/selected archive absent')
    require(all(b in q['retained_issue_reports'] for b in required_issue_reports(original)),'original issue/history omitted')
    for binding in entry['retained_issue_bindings']:
        p.checked(binding); require(any(w['source']==binding for w in archives),'declared retained issue archive missing')
    # 343 additive DATA322 obligation applies to every new321 page; no altered321 publisher.
    data=CONTRACTS['DATA322']; final=p.load(p.checked(page['final_review'])); provenance=final['publication provenance']
    require(data in q['retained_issue_reports'] and data in entry['required_archives'],'DATA322 issue/ledger evidence missing')
    require(provenance.get('actual_DATA322')==data,'DATA322 final review provenance missing')
    require(any(w['source']==data for w in archives),'DATA322 no-overwrite archive missing')
    require(page['unresolved_discrepancies'] is True,'unreviewed flag cleared')

def validate_new321(plan,receipt,process,qualification,*,raw,guard,root,manifest,before,schema_validator):
    p=Evidence(plan,before,root,raw,guard)
    require(plan['root_source_amendment_gate']==qualification['Gate'],'release Gate not trusted Root Gate')
    require(plan['matrix']==CONTRACTS['matrix'] and plan['policy']==CONTRACTS['original_policy'],'release matrix/policy drift')
    require(qualification['release']==receipt['release'],'Root exact release mismatch')
    require(plan['nonce']==receipt['nonce']==qualification['nonce'],'Root nonce mismatch')
    entries=admit(p,copy.deepcopy(plan),manifest)
    executions=receipt['helper_execution']; require(isinstance(executions,list) and executions,'helper execution absent')
    for e in executions:
        for role in ('expected_sha256','authenticated_sha256','compiled_input_sha256'): require(e[role]==SUBJECT['source_amendment321.py'],'helper buffer drift')
        require(e['resolved_path']==e['code_filename']==e['admit_code_filename']==PUBLISHER_FILES[1]['path'],'helper path drift')
        require(e['admit_module']==e['module_name']=='_publisher321_authenticated_helper_'+SUBJECT['source_amendment321.py'],'helper identity drift')
    require(receipt['pages']==[page['page'] for page in plan['pages']] and receipt['qualification']==[page['qualification'] for page in plan['pages']],'receipt page qualification mismatch')
    expected={'format':'mechanical-qualification276-v1','nonce':plan['nonce'],'authority':plan['authority'],'policy':plan['policy'],'delegation':plan['delegation'],'pages':[{'page':page['page'],'qualification':page['qualification']} for page in plan['pages']]}
    require(p.load(p.checked(plan['qualification']))==expected,'mechanical qualification mismatch')
    require(sorted((b['path'],b['sha256']) for b in receipt['actual_afterimages'])==sorted((w['target'],w['source']['sha256']) for w in plan['writes']),'actual afterimage subjects mismatch')
    expected_archives=sorted((w['target'],w['source']['sha256']) for w in plan['writes'] if w['purpose']=='archive')
    require(sorted((a['path'],a['sha256']) for a in receipt['archive_verification'] if a['verified'] is True)==expected_archives,'archive verification subjects mismatch')
    for w in plan['writes']:
        if w['purpose']=='archive': require(sha(raw(w['target']))==w['source']['sha256'],'archive target bytes drift')
    for page in plan['pages']:
        verify_page_evidence(p,page,entries[page['page']])
        verify_saved_models(p,page,entries[page['page']],schema_validator)
    return entries


def strict_directory_guard(path):
    p=Path(path)
    require(p.is_absolute() and p.resolve()==p.absolute(),'aliased directory path')
    for a in (p,*p.parents):
        st=a.lstat()
        require(not stat.S_ISLNK(st.st_mode) and not(getattr(st,'st_file_attributes',0)&1024),'reparse directory path')
    require(p.is_dir(),'directory required')
    return p

def verify_saved_models(p,page,entry,schema_validator):
    """Pure JSON checks; caller supplies actual full Draft202012Validator class."""
    model=p.load(p.checked(page['data'])); emitted=p.load(p.checked(page['qualification']['emitted_data']))
    schema=p.load(p.checked(page['schema'])); original=p.load(p.checked(page['original_review'])); final=p.load(p.checked(page['final_review']))
    def refs(value):
        if isinstance(value,dict):
            for key,v in value.items():
                if key in ('$ref','$dynamicRef'): require(isinstance(v,str) and v.startswith('#'),'external schema ref unsupported')
                refs(v)
        elif isinstance(value,list):
            for v in value: refs(v)
    refs(schema); schema_validator.check_schema(schema)
    schema_validator(schema).validate(model); schema_validator(schema).validate(emitted)
    require(model['$schema']=='https://raw.githubusercontent.com/iamcamiel/ibm360ald/main/schema/ALD_v4.json' and model['page']['page']==page['page'],'saved V4 identity mismatch')
    require(model['review']['approved'] is False and model['review']['unresolved discrepancies'] is page['unresolved_discrepancies'] is True,'saved review flags changed')
    require({k:v for k,v in model.items() if k!='review'}=={k:v for k,v in emitted.items() if k!='review'},'emitted functional content changed')
    digest=sha(json.dumps({k:v for k,v in model.items() if k!='review'},ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False).encode('utf8'))
    require(digest==original['content sha256']==final['content sha256'],'saved content digest drift')
    old=p.load(p.checked(entry['original_record']['canonical_preimage']['json'])); selected=p.load(p.checked(page['source']['model']))
    require(old['schema']==selected['schema']=='ibm360-ald-page-v3' and old['page']['page']==selected['page']['page']==page['page'],'original/selected V3 identity drift')
    require(original.get('inherited review')==selected['review'],'selected inherited review changed')
    require('publication provenance' not in original,'original review already published')
    adjusted=copy.deepcopy(original); seen=set()
    for delta in page['review_delta']:
        require(delta['pointer']=='/reviewer' and delta['pointer'] not in seen,'review finding edits forbidden')
        seen.add(delta['pointer']); require(adjusted['reviewer']==delta['before'] and isinstance(delta['after'],str),'review delta preimage mismatch')
        adjusted['reviewer']=delta['after']
    adjusted['publication provenance']=final['publication provenance']
    require(adjusted==final,'full review inverse changed')
    provenance=final['publication provenance']; q=page['qualification']
    require(provenance.get('original_canonical_review')==old['review'] and provenance.get('selected_source_review')==selected['review'],'canonical/selected approval history changed')
    require(provenance.get('contract')=='successful-current-conversion276-unreviewed' and provenance.get('manifest_record')==entry['original_record'],'complete original276 history changed')
    require(provenance.get('known_issues')==q['known_issues'] and provenance.get('retained_issue_reports')==q['retained_issue_reports'],'known issue provenance changed')
    require(provenance.get('approved') is False and provenance.get('source_approval') is False and provenance.get('local_only') is True,'false approval provenance')
    require(provenance.get('unreviewed') is True and provenance.get('SOURCE_DATA_PASS') is False and provenance.get('no_known_loss_claim') is False,'false clean attestation')
