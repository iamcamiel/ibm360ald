      "row": 74,
      "column": 5,
      "text": "THE PURPOSE OF TRUNCATION IS TO",
      "kind": "standalone text"
    },
    {
      "row": 75,
      "column": 5,
      "text": "RETURN A PT WHICH LIES OUTSIDE THE",
      "kind": "standalone text"
    },
    {
      "row": 76,
      "column": 5,
      "text": "GEO BOUND OF A PVD TO SOME PT WITHIN",
      "kind": "standalone text"
    },
    {
      "row": 77,
      "column": 5,
      "text": "THE GEO BOUND AND THE 9D BORDER OF",
      "kind": "standalone text"
    },
    {
      "row": 78,
      "column": 5,
      "text": "THE PVD.THE ABOVE HALVING FUNCTION",
      "kind": "standalone text"
    },
    {
      "row": 79,
      "column": 5,
      "text": "IS APPLIED.A MAXIMUM OF NINE ATT-",
      "kind": "standalone text"
    },
    {
      "row": 80,
      "column": 5,
      "text": "EMPTS ARE MADE TO RETURN THE POINT",
      "kind": "standalone text"
    },
    {
      "row": 81,
      "column": 5,
      "text": "TO THE PVD AREA.IF TRUNCATION IS NOT",
      "kind": "standalone text"
    },
    {
      "row": 82,
      "column": 5,
      "text": "SUCCESSFUL AFTER THESE ATTEMPTS THEN",
      "kind": "standalone text"
    },
    {
      "row": 83,
      "column": 5,
      "text": "THE LINE WILL BE REJECTED.",
      "kind": "standalone text"
    },
    {
      "row": 2,
      "column": 203,
      "text": "EXIT TO MULT ROUT VIA QQ261 AND MULT",
      "kind": "standalone text"
    },
    {
      "row": 3,
      "column": 203,
      "text": "THE MAJOR POSITION FIRST BY THE",
      "kind": "standalone text"
    },
    {
      "row": 4,
      "column": 203,
      "text": "CONSTANT IN GPR 11 FOLLOWED BY A",
      "kind": "standalone text"
    },
    {
      "row": 5,
      "column": 203,
      "text": "MULT OF THE SECONDARY POSITION.",
      "kind": "standalone text"
    },
